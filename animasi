  <script type="module">
    // Import SDK Firebase v10.14.1
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";
    import { getDatabase, ref, onValue } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-database.js";

    // Configuration
    const firebaseConfig = {
      apiKey: "AIzaSyAp-xABc3sjcsLa2GFBEOlK0BmdP7BjC2U",
      authDomain: "wokwi-eea2f.firebaseapp.com",
      databaseURL: "https://wokwi-eea2f-default-rtdb.firebaseio.com",
      projectId: "wokwi-eea2f",
      storageBucket: "wokwi-eea2f.appspot.com",
      messagingSenderId: "126495132632",
      appId: "1:126495132632:web:bf9ed735696fdb72d200ad",
      measurementId: "G-E9RN7W9R08"
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);
    const sensorDataRef = ref(db, 'sensorData');

    // DOM Connection status elements
    const connectionBadge = document.getElementById('connectionBadge');
    const connIcon = document.getElementById('connIcon');
    const connText = document.getElementById('connText');

    // Simulation Visual Elements
    const farmSky = document.getElementById('farmSky');
    const skyIcon = document.getElementById('skyIcon');
    const skyModeLabel = document.getElementById('skyModeLabel');
    const celestialOrb = document.getElementById('celestialOrb');
    const celestialIcon = document.getElementById('celestialIcon');
    const lightPercentLabel = document.getElementById('lightPercentLabel');
    
    // Actuators
    const acUnit = document.getElementById('acUnit');
    const acFanIcon = document.getElementById('acFanIcon');
    const acStatusText = document.getElementById('acStatusText');
    const acWindStream = document.getElementById('acWindStream');
    const acBadge = document.getElementById('acBadge');

    const heaterUnit = document.getElementById('heaterUnit');
    const heaterBadge = document.getElementById('heaterBadge');

    const sprinklerSpray = document.getElementById('sprinklerSpray');
    const valveIcon = document.getElementById('valveIcon');
    const wateringBadge = document.getElementById('wateringBadge');

    const insectGraphic = document.getElementById('insectGraphic');
    const sensorDistanceDisplay = document.getElementById('sensorDistanceDisplay');
    const alarmBadge = document.getElementById('alarmBadge');

    // Sliders
    const simLdr = document.getElementById('simLdr');
    const simTemp = document.getElementById('simTemp');
    const simHum = document.getElementById('simHum');
    const simDist = document.getElementById('simDist');

    const simLdrVal = document.getElementById('simLdrVal');
    const simTempVal = document.getElementById('simTempVal');
    const simHumVal = document.getElementById('simHumVal');
    const simDistVal = document.getElementById('simDistVal');
    const resetSyncBtn = document.getElementById('resetSyncBtn');

    let isManualOverride = false;

    // Fungsi Kalibrasi LDR dari kode Anda
    function calibrateLightIntensity(rawValue) {
      const minValue = 32;
      const maxValue = 4063;
      let calculated = ((rawValue - minValue) / (maxValue - minValue)) * 100;
      if (isNaN(calculated)) return 0;
      return Math.max(0, Math.min(100, calculated));
    }

    // Fungsi Utama Pembaruan Data & Tampilan Dashboard
    function processSensorData(data) {
      const distance = Number(data.distance ?? 50);
      const humidity = Number(data.humidity ?? 50);
      const temperature = Number(data.temperature ?? 25);
      const rawLightIntensity = Number(data.lightIntensity ?? 2000);

      // 1. Kalibrasi nilai intensitas cahaya (0 - 100%)
      const lightIntensity = calibrateLightIntensity(rawLightIntensity).toFixed(2);

      // 2. Tentukan status Siang/Malam
      const lightIntensityStatus = (lightIntensity > 50) ? "Day" : "Night";

      // 3. Evaluasi Ambang Batas Suhu dan Kelembapan
      let temperatureStatus, humidityStatus;

      if (lightIntensityStatus === "Day") {
        temperatureStatus = (temperature < 20) ? "Heater On" : (temperature > 30) ? "Cooler On" : "Good";
        humidityStatus = (humidity < 40) ? "Watering On" : (humidity > 60) ? "Best" : "Good";
      } else {
        temperatureStatus = (temperature < 15) ? "Heater On" : (temperature > 25) ? "Cooler On" : "Good";
        humidityStatus = (humidity < 50) ? "Watering On" : (humidity > 80) ? "Best" : "Good";
      }

      // 4. Deteksi Hama / Serangga berdasarkan jarak (< 30 cm)
      const distanceStatus = (distance < 30) ? "Alarm On" : "Alarm Off";

      // 5. Update Output Angka ke DOM Card
      document.getElementById('temperatureValue').innerHTML = `${temperature} °C`;
      document.getElementById('distanceValue').innerHTML = `${distance} cm`;
      document.getElementById('humidityValue').innerHTML = `${humidity} %`;
      document.getElementById('lightIntensityValue').innerHTML = `${lightIntensity} %`;

      // Update Output Status Text ke DOM Card
      document.getElementById('lightIntensityStatus').innerHTML = `${lightIntensityStatus}`;
      document.getElementById('temperatureStatus').innerHTML = `${temperatureStatus}`;
      document.getElementById('humidityStatus').innerHTML = `${humidityStatus}`;
      document.getElementById('distanceStatus').innerHTML = `${distanceStatus}`;

      // 6. Ubah Warna Card Berdasarkan Fungsi Warna Anda
      changeCardColor('temperature', temperatureStatus);
      changeCardColor('humidity', humidityStatus);
      changeCardColor('distance', distanceStatus);
      changeCardColor('lightIntensity', lightIntensityStatus);

      // 7. SINKRONISASI VISUAL SIMULASI 2D
      updateVisualSimulation({
        lightIntensity,
        lightIntensityStatus,
        temperatureStatus,
        humidityStatus,
        distance,
        distanceStatus
      });
    }

    // Fungsi Pengubah Warna Card Sesuai Logika Anda
    function changeCardColor(sensor, status) {
      const card = document.querySelector(`#${sensor}Status`).parentElement;
      const hrList = card.querySelectorAll('hr');

      if (sensor === "temperature") {
        if (status === "Heater On") {
          card.style.backgroundColor = '#A72925';
          card.style.color = '#FFFFFF';
          hrList.forEach(hr => hr.style.borderColor = '#FFFFFF');
        } else if (status === "Cooler On") {
          card.style.backgroundColor = '#00BFFF';
          card.style.color = '#FFFFFF';
          hrList.forEach(hr => hr.style.borderColor = '#FFFFFF');
        } else if (status === "Good") {
          card.style.backgroundColor = '#DCF2F1';
          card.style.color = '#0F1035';
          hrList.forEach(hr => hr.style.borderColor = 'rgba(15, 16, 53, 0.2)');
        }
      }
      else if (sensor === "humidity") {
        if (status === "Watering On") {
          card.style.backgroundColor = '#00BFFF';
          card.style.color = '#FFFFFF';
          hrList.forEach(hr => hr.style.borderColor = '#FFFFFF');
        } else if (status === "Best") {
          card.style.backgroundColor = '#2C632C';
          card.style.color = '#FFFFFF';
          hrList.forEach(hr => hr.style.borderColor = '#FFFFFF');
        } else if (status === "Good") {
          card.style.backgroundColor = '#DCF2F1';
          card.style.color = '#0F1035';
          hrList.forEach(hr => hr.style.borderColor = 'rgba(15, 16, 53, 0.2)');
        }
      }
      else if (sensor === "distance") {
        if (status === "Alarm On") {
          card.style.backgroundColor = '#A72925';
          card.style.color = '#FFFFFF';
          hrList.forEach(hr => hr.style.borderColor = '#FFFFFF');
        } else {
          card.style.backgroundColor = '#DCF2F1';
          card.style.color = '#0F1035';
          hrList.forEach(hr => hr.style.borderColor = 'rgba(15, 16, 53, 0.2)');
        }
      }
      else if (sensor === "lightIntensity") {
        if (status === "Day") {
          card.style.backgroundColor = '#DCF2F1';
          card.style.color = '#0F1035';
          hrList.forEach(hr => hr.style.borderColor = 'rgba(15, 16, 53, 0.2)');
        } else if (status === "Night") {
          card.style.backgroundColor = '#000000';
          card.style.color = '#FFFFFF';
          hrList.forEach(hr => hr.style.borderColor = '#FFFFFF');
        }
      }
    }

    // Update Elemen Grafik Visual 2D Greenhouse
    function updateVisualSimulation(params) {
      const { lightIntensity, lightIntensityStatus, temperatureStatus, humidityStatus, distance, distanceStatus } = params;

      // Daylight vs Night Simulation
      lightPercentLabel.textContent = `Cahaya: ${lightIntensity}%`;
      if (lightIntensityStatus === "Day") {
        farmSky.className = "relative overflow-hidden rounded-3xl border border-slate-800 bg-gradient-to-b from-sky-950 via-slate-900 to-emerald-950/40 p-4 sm:p-8 shadow-2xl transition-all duration-700";
        skyIcon.className = "fa-solid fa-sun text-amber-400";
        skyModeLabel.textContent = "Mode: Siang (Day)";
        
        celestialOrb.className = "w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-gradient-to-tr from-amber-400 to-yellow-200 shadow-[0_0_30px_rgba(245,158,11,0.6)] flex items-center justify-center";
        celestialIcon.className = "fa-solid fa-sun text-3xl sm:text-4xl text-amber-600";
      } else {
        farmSky.className = "relative overflow-hidden rounded-3xl border border-indigo-900/50 bg-gradient-to-b from-slate-950 via-slate-900 to-emerald-950/20 p-4 sm:p-8 shadow-2xl transition-all duration-700";
        skyIcon.className = "fa-solid fa-moon text-indigo-300";
        skyModeLabel.textContent = "Mode: Malam (Night)";

        celestialOrb.className = "w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-gradient-to-tr from-slate-300 to-indigo-100 shadow-[0_0_20px_rgba(199,210,254,0.4)] flex items-center justify-center";
        celestialIcon.className = "fa-solid fa-moon text-3xl sm:text-4xl text-indigo-600";
      }

      // Cooler / AC Visual Status
      if (temperatureStatus === "Cooler On") {
        acUnit.className = "bg-slate-800 border-2 border-cyan-400 rounded-xl p-2.5 shadow-xl shadow-cyan-500/20 flex items-center gap-3 w-40 sm:w-48";
        acFanIcon.className = "fa-solid fa-snowflake text-cyan-400 animate-spin";
        acStatusText.textContent = "COOLING ACTIVE";
        acStatusText.className = "text-[9px] font-bold text-cyan-400";
        acWindStream.classList.remove('hidden');
        acBadge.classList.remove('hidden');
      } else {
        acUnit.className = "bg-slate-800 border-2 border-slate-600 rounded-xl p-2.5 shadow-xl flex items-center gap-3 w-40 sm:w-48";
        acFanIcon.className = "fa-solid fa-fan text-slate-500";
        acStatusText.textContent = "STANDBY";
        acStatusText.className = "text-[9px] font-semibold text-slate-500";
        acWindStream.classList.add('hidden');
        acBadge.classList.add('hidden');
      }

      // Heater Visual Status
      if (temperatureStatus === "Heater On") {
        heaterUnit.classList.remove('hidden');
        heaterBadge.classList.remove('hidden');
      } else {
        heaterUnit.classList.add('hidden');
        heaterBadge.classList.add('hidden');
      }

      // Watering Sprinkler Visual Status
      if (humidityStatus === "Watering On") {
        sprinklerSpray.classList.remove('hidden');
        valveIcon.className = "fa-solid fa-faucet text-cyan-400 animate-bounce";
        wateringBadge.classList.remove('hidden');
      } else {
        sprinklerSpray.classList.add('hidden');
        valveIcon.className = "fa-solid fa-faucet-drip text-slate-400";
        wateringBadge.classList.add('hidden');
      }

      // Insect / Serangga Visual Alarm (< 30cm)
      sensorDistanceDisplay.textContent = `${distance} cm`;
      if (distanceStatus === "Alarm On") {
        insectGraphic.classList.remove('hidden');
        alarmBadge.classList.remove('hidden');
      } else {
        insectGraphic.classList.add('hidden');
        alarmBadge.classList.add('hidden');
      }
    }

    // Mendengarkan Realtime Data dari Firebase
    onValue(sensorDataRef, (snapshot) => {
      if (snapshot.exists()) {
        const data = snapshot.val();
        
        connectionBadge.className = "flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30";
        connIcon.className = "fa-solid fa-circle-check text-[10px]";
        connText.textContent = "RTDB Terhubung";

        if (!isManualOverride) {
          processSensorData(data);

          // Update posisi slider
          simLdr.value = data.lightIntensity ?? 2000;
          simTemp.value = data.temperature ?? 25;
          simHum.value = data.humidity ?? 55;
          simDist.value = data.distance ?? 50;

          simLdrVal.textContent = simLdr.value;
          simTempVal.textContent = `${simTemp.value} °C`;
          simHumVal.textContent = `${simHum.value} %`;
          simDistVal.textContent = `${simDist.value} cm`;
        }
      } else {
        connText.textContent = "Node 'sensorData' Kosong";
      }
    }, (error) => {
      console.error("Firebase Read Error: ", error);
      connectionBadge.className = "flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/30";
      connIcon.className = "fa-solid fa-triangle-exclamation text-[10px]";
      connText.textContent = "Gagal Membaca Firebase";
    });

    // Slider Event Handler untuk Pengujian Manual Langsung
    function handleManualInput() {
      isManualOverride = true;
      connectionBadge.className = "flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/30";
      connIcon.className = "fa-solid fa-sliders text-[10px]";
      connText.textContent = "Mode Simulasi Slider";

      simLdrVal.textContent = simLdr.value;
      simTempVal.textContent = `${simTemp.value} °C`;
      simHumVal.textContent = `${simHum.value} %`;
      simDistVal.textContent = `${simDist.value} cm`;

      processSensorData({
        lightIntensity: Number(simLdr.value),
        temperature: Number(simTemp.value),
        humidity: Number(simHum.value),
        distance: Number(simDist.value)
      });
    }

    simLdr.addEventListener('input', handleManualInput);
    simTemp.addEventListener('input', handleManualInput);
    simHum.addEventListener('input', handleManualInput);
    simDist.addEventListener('input', handleManualInput);

    resetSyncBtn.addEventListener('click', () => {
      isManualOverride = false;
      connText.textContent = "Menyinkronkan ulang...";
    });

    // Initial render
    processSensorData({
      distance: 50,
      humidity: 55,
      temperature: 25,
      lightIntensity: 2000
    });
  </script>
</body>
</html>
