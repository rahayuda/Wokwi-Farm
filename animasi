  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Animasi Pancuran Air Keran */
    @keyframes waterFlow {
      0% { transform: translateY(0) scaleY(1); opacity: 0.9; }
      100% { transform: translateY(110px) scaleY(1.3); opacity: 0.2; }
    }
    .water-stream {
      animation: waterFlow 0.5s linear infinite;
    }

    /* Animasi Hembusan Dingin AC (Cooler) */
    @keyframes acWind {
      0% { transform: translateY(0) scale(0.8); opacity: 0.8; }
      100% { transform: translateY(80px) scale(1.4); opacity: 0; }
    }
    .ac-breeze {
      animation: acWind 1.2s ease-out infinite;
    }

    /* Animasi Radiasi Pemanas (Heater) */
    @keyframes heatWave {
      0%, 100% { opacity: 0.3; transform: scaleY(1); }
      50% { opacity: 0.9; transform: scaleY(1.2); }
    }
    .heat-glow {
      animation: heatWave 1.5s ease-in-out infinite;
    }

    /* Animasi Terbang Serangga / Hama */
    @keyframes bugFly {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(15px, -10px) rotate(10deg); }
      50% { transform: translate(-10px, 15px) rotate(-10deg); }
      75% { transform: translate(10px, 10px) rotate(5deg); }
    }
    .bug-animation {
      animation: bugFly 2s ease-in-out infinite;
    }

    /* Animasi Goyang Tanaman */
    @keyframes plantSway {
      0%, 100% { transform: rotate(0deg); }
      50% { transform: rotate(2deg); }
    }
    .swaying-plant {
      transform-origin: bottom center;
      animation: plantSway 3.5s ease-in-out infinite;
    }

    /* Transition halus untuk perubahan warna card */
    .status-card {
      transition: all 0.5s ease-in-out;
    }
  </style>
